# Crontab for chocochip (Raspberry Pi). Install with:
#   crontab /srv/homelab/hosts/pi/crontab
# Check what's live with: crontab -l
# Times are the Pi's local time (America/Los_Angeles).

# cron's default PATH is just /usr/bin:/bin; the AWS CLI installer puts aws in /usr/local/bin
PATH=/usr/local/bin:/usr/bin:/bin

# --- Apps (each is its own repo, cloned under /srv/apps/) ---

# Scheduler_TDC: books Tutor.com hours every Wednesday at 9:01am
1 9 * * 3 /srv/apps/scheduler-tdc/run.sh

# Old 3-week Wed/Thu/Fri rotation (Jul 1 - Oct 2026), replaced by Wednesday-only above
# 1 9 * * 3,4,5 /srv/apps/scheduler-tdc/run.sh

# --- Platform ---

# Pi health metrics every 5 minutes -> platform/monitoring/metrics.db
*/5 * * * * cd /srv/homelab/platform/monitoring && .venv/bin/python metrics.py >> metrics.log 2>&1
